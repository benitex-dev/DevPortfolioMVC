@using DevPortfolioMVC.Web.Models.ViewModels
@model List<ProjectCardViewModel>

@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-8">
                <span class="hero-badge">Backend Developer</span>

                <h1 class="hero-title">
                    Ezequiel Benítez
                </h1>

                <p class="hero-subtitle">
                    Desarrollo aplicaciones backend con ASP.NET Core, C#, Java, Spring Boot y SQL Server.
                </p>

                <p class="hero-description">
                    Este portfolio reúne proyectos reales, decisiones técnicas y aprendizajes construidos durante mi formación y práctica profesional.
                </p>

                <div class="hero-actions">
                    <a href="#" class="btn btn-primary btn-lg">Ver proyectos</a>
                    <a href="#" class="btn btn-outline-light btn-lg">Contactar</a>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="featured-projects-section">
    <div class="container">
        <div class="section-header">
            <span class="section-label">Portfolio</span>
            <h2>Proyectos destacados</h2>
            <p>
                Algunos trabajos que representan mi formación, práctica y enfoque como desarrollador backend.
            </p>
        </div>

        <div class="row g-4">
            @foreach (var project in Model)
            {
                <div class="col-lg-4">
                    <article class="project-card h-100">
                        <div class="project-card-body">
                            <h3>@project.Title</h3>

                            <p>@project.Description</p>

                            <div class="project-tech-list">
                                @foreach (var tech in project.Technologies)
                                {
                                    <span>@tech</span>
                                }
                            </div>

                            <a href="@project.ProjectUrl" class="project-link">
                                Ver proyecto →
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>
    </div>
</section>