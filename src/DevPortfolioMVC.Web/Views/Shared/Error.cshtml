@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    ViewData["Description"] = "No fue posible procesar la solicitud.";
}

<section class="utility-page-section">
    <div class="container">
        <article class="utility-page-card">
            <span class="section-label">Error</span>
            <h1>No pudimos completar la solicitud</h1>
            <p>
                Ocurrió un inconveniente inesperado. Podés volver al inicio e intentarlo nuevamente.
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="request-id">
                    Identificador del error: <code>@Model.RequestId</code>
                </p>
            }

            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                Volver al inicio
            </a>
        </article>
    </div>
</section>
