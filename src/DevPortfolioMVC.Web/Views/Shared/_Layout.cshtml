<!DOCTYPE html>
@using DevPortfolioMVC.Web.Models.Configuration
@using Microsoft.Extensions.Options
@inject IOptions<PortfolioOptions> PortfolioConfiguration
@{
    var portfolio = PortfolioConfiguration.Value;
    var pageDescription = ViewData["Description"] as string
        ?? "Portfolio de Ezequiel Benítez, desarrollador backend especializado en C#, .NET, Java, Spring Boot y bases de datos relacionales.";
}
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Ezequiel Benítez - Backend Developer</title>
    <meta name="description"
          content="@pageDescription" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    Ezequiel Benítez
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Abrir menú de navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="sobre-mi">
                                Sobre mí
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Project" asp-action="Index">Proyectos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@portfolio.GitHubUrl"
                               target="_blank"
                               rel="noopener noreferrer">
                                GitHub
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@portfolio.LinkedInUrl"
                               target="_blank"
                               rel="noopener noreferrer">
                                LinkedIn
                            </a>
                        </li>
                        @if (!string.IsNullOrWhiteSpace(portfolio.CvUrl))
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm"
                                   href="@portfolio.CvUrl"
                                   download="CV-Jorge-Ezequiel-Benitez.pdf"
                                   type="application/pdf">
                                    Descargar CV
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="contenido-principal" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-content">
            <p class="mb-0">
                © @DateTime.Now.Year - Ezequiel Benítez · Backend Developer
            </p>
            <div class="footer-links" aria-label="Redes profesionales">
                <a href="mailto:@portfolio.Email">@portfolio.Email</a>
                <a href="@portfolio.GitHubUrl"
                   target="_blank"
                   rel="noopener noreferrer">
                    GitHub
                </a>
                <a href="@portfolio.LinkedInUrl"
                   target="_blank"
                   rel="noopener noreferrer">
                    LinkedIn
                </a>
                <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
