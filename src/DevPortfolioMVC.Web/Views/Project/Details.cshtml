@using DevPortfolioMVC.Web.Models.ViewModels
@{
    ViewData["Title"] = Model.Title;
}
@model ProjectDetailViewModel

<section class="project-detail-hero">
    <div class="container">
        <a asp-controller="Home" asp-action="Index" class="project-back-link">
            ← Volver al inicio
        </a>

        <span class="section-label">@Model.Category</span>

        <h1>@Model.Title</h1>

        <p class="project-detail-summary">
            @Model.Summary
        </p>

        <div class="project-tech-list">
            @foreach (var technology in Model.Technologies)
            {
                <span>@technology</span>
            }
        </div>
    </div>
</section>

<section class="project-detail-content">
    <div class="container">
        <article class="project-content-card">
            <h2>¿Qué problema resolvía?</h2>
            <p>
                @Model.Problem
            </p>

            <h2>¿Cómo lo desarrollé?</h2>
            <p>
                @Model.Development
            </p>

            <h2>Lo que aprendí</h2>
            <ul>
                @foreach (var learning in Model.Learnings)
                {
                    <li>@learning</li>
                }
            </ul>

            <h2>Próximas mejoras</h2>
            <ul>
                @foreach (var improvement in Model.FutureImprovements)
                {
                    <li>@improvement</li>
                }
            </ul>
        </article>
    </div>
</section>
